{
	"mcpServers": {
		"eye-mcp-unlimited": {
			"command": "python3",
			"args": ["bin/mcp-front.py", "browser_use.retinat"],
			"env": {"BROWSER_USE_PROXY_CA_CERT": "${BROWSER_USE_PROXY_CA_CERT:-/root/.ccr/agent-proxy-ca.crt}"}
		},
		"browser-use": {
			"command": "python3",
			"args": ["bin/mcp-front.py", "browser_use.mcp"],
			"env": {"BROWSER_USE_PROXY_CA_CERT": "${BROWSER_USE_PROXY_CA_CERT:-/root/.ccr/agent-proxy-ca.crt}"}
		}
	}
}
