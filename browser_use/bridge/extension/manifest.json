{
  "manifest_version": 3,
  "name": "Retinat bridge",
  "version": "0.4.0",
  "description": "Lets an AI assistant you run on this computer use tabs you share with it, in your own browser.",
  "minimum_chrome_version": "88",
  "key": "",
  "permissions": [
    "debugger",
    "tabs",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "Retinat bridge",
    "default_popup": "popup.html"
  },
  "commands": {
    "toggle-share": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Share or stop sharing this tab with the AI"
    },
    "toggle-control": {
      "suggested_key": {
        "default": "Alt+Shift+Z"
      },
      "description": "Take the wheel from the AI, or hand it back"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "watch.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
