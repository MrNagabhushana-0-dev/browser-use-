diff --git a/tests/ci/test_synthesis_fingerprint.py b/tests/ci/test_synthesis_fingerprint.py
new file mode 100644
index 0000000..9c69d8b
--- /dev/null
+++ b/tests/ci/test_synthesis_fingerprint.py
@@ -0,0 +1,78 @@
+"""A cached tool surface must survive the reader looking somewhere else.
+
+The fingerprint exists to notice a redesign. It must not notice a scroll. The published
+affordance lists are capped by viewport relevance — that is the right trade for what the
+agent gets shown — but hashing them made the cache key a function of the scroll position,
+so a tall page threw away its manifest, verified flags and all, and rewrote it, every time
+the viewport moved. And renaming a form-less control, which is a real tool, changed
+nothing at all, because the hash ignored `controls` outright.
+"""
+
+import asyncio
+
+import pytest
+from pytest_httpserver import HTTPServer
+
+from browser_use.browser.events import NavigateToUrlEvent
+from browser_use.synthesis import SiteToolSynthesizer
+from browser_use.synthesis.store import fingerprint
+
+# More named buttons at the top than the budget holds, and as many again four thousand
+# pixels below it. Whichever end the viewport is at, the capped list is drawn from that
+# end — which is the point of the ranking, and exactly what the fingerprint must ignore.
+TALL_PAGE = (
+	'<html><head><title>Tall</title></head><body style="margin:0">'
+	'<div>' + ''.join(f'<button>Top action {i}</button>' for i in range(30)) + '</div>'
+	'<div style="height:4000px"></div>'
+	'<div>' + ''.join(f'<button>Bottom action {i}</button>' for i in range(30)) + '</div>'
+	'</body></html>'
+)
+
+
+@pytest.fixture(scope='module')
+def tall_server():
+	server = HTTPServer()
+	server.start()
+	server.expect_request('/tall').respond_with_data(TALL_PAGE, content_type='text/html')
+	yield server
+	server.stop()
+
+
+async def _goto(session, url):
+	event = session.event_bus.dispatch(NavigateToUrlEvent(url=url))
+	await event
+	await event.event_result(raise_if_any=True, raise_if_none=False)
+
+
+async def test_the_fingerprint_does_not_move_with_the_scroll_position(browser_session, tall_server):
+	await _goto(browser_session, tall_server.url_for('/tall'))
+
+	synth = SiteToolSynthesizer(browser_session)
+	at_top = await synth.scan()
+
+	await browser_session.run_page_script('window.scrollTo(0, document.body.scrollHeight); return true;')
+	await asyncio.sleep(0.5)
+	at_bottom = await synth.scan()
+
+	top_names = [button['name'] for button in at_top.get('buttons') or []]
+	bottom_names = [button['name'] for button in at_bottom.get('buttons') or []]
+	assert top_names and bottom_names, 'nothing was scanned'
+	# If these matched, the page is not crowded enough to exercise the cap and the test
+	# below would pass for the wrong reason.
+	assert top_names != bottom_names, f'the cap did not bind: {top_names[:3]} vs {bottom_names[:3]}'
+
+	assert fingerprint(at_top) == fingerprint(at_bottom), (
+		'scrolling rewrote the cache key, so the manifest and its verified flags are discarded'
+	)
+
+
+def test_renaming_a_form_less_control_invalidates_the_surface():
+	"""A search box outside a form becomes a tool. Renaming it breaks that tool's locator,
+	which is the whole condition the fingerprint is supposed to detect."""
+	base = {'controls': [{'name': 'Search products'}]}
+	renamed = {'controls': [{'name': 'Find products'}]}
+	assert fingerprint(base) != fingerprint(renamed)
+
+	shaped = {'shape': {'buttons': [], 'controls': ['Search products'], 'forms': []}}
+	shaped_renamed = {'shape': {'buttons': [], 'controls': ['Find products'], 'forms': []}}
+	assert fingerprint(shaped) != fingerprint(shaped_renamed)
