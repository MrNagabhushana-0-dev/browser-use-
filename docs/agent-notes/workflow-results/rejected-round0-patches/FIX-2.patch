diff --git a/tests/ci/test_synthesis_loose_controls.py b/tests/ci/test_synthesis_loose_controls.py
new file mode 100644
index 0000000..4c03d66
--- /dev/null
+++ b/tests/ci/test_synthesis_loose_controls.py
@@ -0,0 +1,120 @@
+"""A search box that belongs to no <form> — which is how most of the modern web ships it.
+
+The scanner has always collected visible controls outside any form and reported them as
+`controls`, on the reasoning that "a site-wide search box usually lives here". Synthesis
+never read that list, so the single commonest affordance on the web went missing on every
+site that wires its search box to a keydown handler instead of a form submit. The page
+below is exactly that shape: one `<input type=search>`, no form, Enter handled in JS.
+"""
+
+import json
+
+import pytest
+from pytest_httpserver import HTTPServer
+
+from browser_use.browser.events import NavigateToUrlEvent
+from browser_use.synthesis import SiteToolSynthesizer
+
+# No <form> anywhere. The checkbox is deliberately labelled with a search word: it must be
+# rejected for being a checkbox, not for what it happens to be called.
+SPA_PAGE = """&lt;!DOCTYPE html&gt;
+&lt;html&gt;&lt;head&gt;&lt;title&gt;SPA Shop&lt;/title&gt;&lt;/head&gt;&lt;body&gt;
+	&lt;input type="search" placeholder="Search products" id="s"&gt;
+	&lt;input type="checkbox" id="stock" aria-label="Find in stock only"&gt;
+	&lt;div id="out"&gt;idle&lt;/div&gt;
+&lt;script&gt;
+	s.addEventListener('keydown', e =&gt; { if (e.key === 'Enter') out.textContent = s.value; });
+&lt;/script&gt;
+&lt;/body&gt;&lt;/html&gt;"""
+
+# A loose text field that is nothing to do with search. Pressing Enter in it is a guess,
+# so it must not become a tool.
+PLAIN_PAGE = """&lt;!DOCTYPE html&gt;
+&lt;html&gt;&lt;head&gt;&lt;title&gt;Notes&lt;/title&gt;&lt;/head&gt;&lt;body&gt;
+	&lt;input type="text" aria-label="Nickname" id="nick"&gt;
+	&lt;input type="password" aria-label="Search vault" id="pw"&gt;
+&lt;/body&gt;&lt;/html&gt;"""
+
+
+@pytest.fixture(scope='module')
+def spa_server():
+	server = HTTPServer()
+	server.start()
+	server.expect_request('/spa').respond_with_data(SPA_PAGE, content_type='text/html')
+	server.expect_request('/plain').respond_with_data(PLAIN_PAGE, content_type='text/html')
+	yield server
+	server.stop()
+
+
+async def _goto(session, url):
+	event = session.event_bus.dispatch(NavigateToUrlEvent(url=url))
+	await event
+	await event.event_result(raise_if_any=True, raise_if_none=False)
+
+
+async def _out_text(session) -&gt; str:
+	out = await session.run_page_script("return document.getElementById('out').textContent;")
+	return json.loads(out.value)
+
+
+async def test_a_form_less_search_box_becomes_a_search_tool(browser_session, spa_server):
+	"""No &lt;form&gt;, so nothing in the forms list — and previously nothing at all."""
+	await _goto(browser_session, spa_server.url_for('/spa'))
+	page_tools = await browser_session.get_webmcp_tools()
+	names = [tool.name for tool in page_tools.tools]
+
+	assert 'search' in names, f'the form-less search box yielded no tool: {sorted(names)}'
+	search = next(tool for tool in page_tools.tools if tool.name == 'search')
+	assert search.source == 'synthesized'
+	assert search.input_schema['properties']['query']['type'] == 'string'
+	assert search.input_schema['required'] == ['query']
+
+
+async def test_the_form_less_search_tool_really_searches(browser_session, spa_server):
+	"""Enter in the box is the submit, which is what ToolStep.key exists for."""
+	await _goto(browser_session, spa_server.url_for('/spa'))
+	await browser_session.get_webmcp_tools()
+
+	result = await browser_session.call_webmcp_tool('search', {'query': 'lamp'})
+	assert result.ok, result.error
+	assert await _out_text(browser_session) == 'lamp'
+
+
+async def test_a_loose_checkbox_does_not_become_a_search_tool(browser_session, spa_server):
+	"""Its label says "Find", which is a search word. Its role says checkbox, which wins."""
+	await _goto(browser_session, spa_server.url_for('/spa'))
+	page_tools = await browser_session.get_webmcp_tools()
+	names = [tool.name for tool in page_tools.tools]
+
+	assert [n for n in names if n.startswith('search')] == ['search'], f'a checkbox became a search tool: {sorted(names)}'
+	# It is still offered — as the toggle it actually is.
+	assert any(n.startswith('set_') for n in names), f'the checkbox lost its toggle tool: {sorted(names)}'
+
+
+async def test_a_loose_field_that_is_not_search_is_left_alone(browser_session, spa_server):
+	"""And a password field stays out of the surface however it is labelled."""
+	await _goto(browser_session, spa_server.url_for('/plain'))
+	manifest = await SiteToolSynthesizer(browser_session).synthesize()
+	names = [tool.name for tool in manifest.tools]
+
+	assert names == [], f'a plain text field and a password box became tools: {names}'
+
+
+async def test_a_form_field_is_not_also_offered_loose(browser_session):
+	"""Belt and braces: whatever a form tool already drives must not come back twice."""
+	server = HTTPServer()
+	server.start()
+	try:
+		server.expect_request('/both').respond_with_data(
+			'&lt;html&gt;&lt;body&gt;&lt;form&gt;&lt;input type="search" aria-label="Search products"&gt;'
+			'&lt;button type="submit"&gt;Go&lt;/button&gt;&lt;/form&gt;&lt;/body&gt;&lt;/html&gt;',
+			content_type='text/html',
+		)
+		await _goto(browser_session, server.url_for('/both'))
+		manifest = await SiteToolSynthesizer(browser_session).synthesize()
+		names = [tool.name for tool in manifest.tools]
+
+		assert names.count('search') == 1, names
+		assert 'search_2' not in names, f'the form field came back as a second tool: {names}'
+	finally:
+		server.stop()
